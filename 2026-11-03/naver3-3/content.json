 "blocks": [
  {
   "id": "n001",
   "type": "PARAGRAPH",
   "text": "계절이 바뀔 때마다 두툼한 이불과 패드를 어디에 숨겨야 할지 고민이 많아지죠."
  },
  {
   "id": "n002",
   "type": "PARAGRAPH",
   "text": "옷장은 항상 좁고 지퍼는 닫히지 않아 한숨을 쉬었던 적이 있다면 오늘 이 글을 더더욱 주목해 보세요."
  },
  {
   "id": "n003",
   "type": "PARAGRAPH",
   "text": "집안일 중에서도 특히 침구류 정리는 마음을 먹고 시작해야 할 만큼 번거롭고 손이 많이 가는 과정이에요."
  },
  {
   "id": "n004",
   "type": "PARAGRAPH",
   "text": "오늘은 공간을 깔끔하고 효율적으로 정리해 주는 아이템을 꼼꼼히 살펴보려고 해요."
  },
  {
   "id": "n005",
   "type": "PARAGRAPH",
   "text": "판매 페이지와 공식 안내를 보면 이불 정리에 특화된 제품이라고 합니다."
  },
  {
   "id": "n006",
   "type": "PARAGRAPH",
   "text": "이 제품은 브랜든압축파우치 XXL 사이즈 2개로 이루어진 세트 구성이에요."
  },
  {
   "id": "n007",
   "type": "PARAGRAPH",
   "text": "가격은 재료 페이지 기준 156,000원으로 확인되더라고요."
  },
  {
   "id": "n008",
   "type": "PARAGRAPH",
   "text": "시중의 저렴한 압축팩과 어떤 점이 다른지 궁금해서 상세 설명을 자세히 들여다보았죠."
  },
  {
   "id": "n009",
   "type": "PARAGRAPH",
   "text": "부피가 큰 토퍼나 구스 이불을 억지로 구겨 넣지 않고도 깔끔하게 부피를 줄일 수 있다고 해요."
  },
  {
   "id": "n010",
   "type": "H2",
   "text": "브랜든압축파우치 구성과 가격 비교"
