# ===== AI 글 생성 (Claude API) =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# 1 = 특징메모가 비고 제미나이로도 못 찾으면 Claude가 웹 검색 (검색 1회 약 15원, 상품당 최대 3회) / 0 = 끔
AUTO_RESEARCH=0

# ===== 특징메모 자동 작성 (구글 제미나이, 무료) =====
# aistudio.google.com → Get API key. 메모가 비면 상품 캡처를 읽고 특징을 정리
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AUTO_MEMO=1
# (선택) 조사 결과 저장 파일. 두 계정 폴더가 같은 파일을 쓰면 한 번 조사한 상품은 양쪽 모두 재사용
# 예: RESEARCH_FILE=C:\coupang-shared\research.json
RESEARCH_FILE=

# ===== 쓰레드 =====
THREADS_ACCESS_TOKEN=
# 앱 시크릿을 넣으면 test.bat 실행 시 단기 토큰을 장기 토큰으로 바꿔 줍니다 (선택)
THREADS_APP_SECRET=
# 아래 ID는 test.bat이 자동으로 채웁니다
THREADS_USER_ID=
THREADS_API_VERSION=v1.0
# 쓰레드에 원본 사진·영상을 붙임(1). 자막·[광고] 표시·나레이션·소리는 넣지 않음. 0이면 글만
THREADS_MEDIA=1
# 게시 후 첫 댓글 자동 작성 (1=켜기, 0=끄기). 메타 앱 권한에 threads_manage_replies 필요
THREADS_REPLY=0
# 1이면 구매 링크를 본문 대신 첫 댓글에 넣음: [광고] 한 줄 + 대가성 문구 + 링크 (0이면 링크는 본문에)
THREADS_LINK_IN_REPLY=1
# 댓글에 같은 링크를 몇 번 적을지 (한 개가 죽는 경우 대비)
THREADS_LINK_REPEAT=3
# 본글 게시 후 댓글까지 기다리는 시간(초)
THREADS_REPLY_DELAY=20

# ===== 인스타그램 (프로페셔널 계정) =====
IG_ACCESS_TOKEN=
# 아래 ID는 test.bat이 자동으로 채웁니다
IG_USER_ID=
IG_API_VERSION=v23.0

# ===== 이미지·영상 =====
# 이미지·영상 업로드용 (cloudinary.com 무료 가입 → 대시보드의 API environment variable 값)
# 형식: cloudinary://API키:API시크릿@클라우드이름
CLOUDINARY_URL=
# (선택) 이미지만 올릴 때 imgbb 키로 대신 가능. CLOUDINARY_URL이 있으면 무시됨
IMGBB_API_KEY=
# 형식 칸이 비었을 때: 번갈아 / 이미지 / 영상
DEFAULT_FORMAT=번갈아
# 1 = '이미지' 형식을 여러 장(캐러셀: 표지·장점·구매안내)으로 / 0 = 이미지 1장으로
CAROUSEL=1
# (선택) 상품별 사진 폴더들이 들어 있는 상위 폴더 (기본: 프로그램 폴더 안의 '사진')
PHOTO_DIR=
# (선택) 영상 배경음악 폴더. 저작권 없는 mp3를 넣어두면 무작위로 사용 (비우면 무음)
BGM_DIR=
# 영상 오른쪽 위 광고 표시 (영상 1080×1920 기준 픽셀. 숫자를 키우면 안쪽/아래로 이동)
VIDEO_AD_TAG=[광고]
VIDEO_AD_RIGHT=60
VIDEO_AD_TOP=60
VIDEO_AD_SIZE=34
# 카드 이미지(캐러셀·1장) 오른쪽 위 광고 표시 (1080×1350 기준 픽셀)
CARD_AD_TAG=[광고]
CARD_AD_RIGHT=50
CARD_AD_TOP=50
CARD_AD_SIZE=34
# (선택) 카드·영상 글꼴 (기본: 맑은 고딕 굵게)
FONT_PATH=

# ===== 인스타 글 끝 링크 안내 문구 ({상품명}은 자동으로 바뀜) =====
IG_LINK_TEXT=🔗 구매 링크는 프로필 링크에서 '{상품명}' 찾아주세요

# ===== 동작 설정 =====
# 같은 상품 판단: 쉼표앞(기본, 컬러·수량 옵션은 같은 상품으로 보고 한 번만 게시) / 전체(옵션별로 따로 게시)
SAME_PRODUCT=쉼표앞
# 한 번 실행될 때 올릴 상품 수
POSTS_PER_RUN=1
# 자동 게시 (1=켜기, 0=끄기)와 게시 시각(한국 시간, 띄어쓰기로 구분).
# 서버는 매시간 확인해서 지난 회차를 올림. 프로그램(app.py) 설정 탭에서 바꾸면 서버에도 적용
AUTO_POST=1
POST_TIMES=07:00 12:00 19:00
# 일반 글(광고 아님): 쓰레드에 링크 없는 소통용 글. 시각과 계정 주제
GENERAL_ON=1
GENERAL_TIMES=09:30 21:30
GENERAL_THEME=뷰티·건강 꿀팁
# 일반 글에 글자 카드 이미지 한 장: 카드 / 없음
GENERAL_IMAGE=사진
PIXABAY_API_KEY=
# 채널 켜고 끄기
THREADS_ON=1
IG_ON=1

# ===== 프로그램(app.py)의 '지금 게시' 버튼용 (PC에만) =====
# 깃허브 키: Actions 읽기·쓰기 권한 (프로그램 게시 탭 '깃허브 키 만드는 법')
GITHUB_TOKEN=
GITHUB_REPO=todayinfopick/pick
